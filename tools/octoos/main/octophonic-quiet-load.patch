+// A .reu goes into the REU with no MiSTer OSD bar (build 6): Main sends it itself (octo_load.cpp)
+// and, while the 6502 is still waiting on its request (STATUS stays 1, busy), keeps VALUE 3 and
+// RESULT = 64 KB blocks in so far, LEN = 64 KB blocks in all, up to date - SHELL.PRG draws its own
+// bar from them. STATUS is not written, so the request carries on; the answer comes at the end.
+static void reu_progress(uint32_t done, uint32_t total)
+{
+	uint32_t t = (total + 65535) >> 16;
+	uint32_t d = done >= total ? t : done >> 16;
+	spi_uio_cmd_cont(UIO_OCTO_WRITE);
+	spi_w((R_RSEQ << 8) | cur_seq);               // a request the 6502 gave up on gets none of it
+	spi_w((R_RESL << 8) | (d & 0xFF));
+	spi_w((R_RESH << 8) | ((d >> 8) & 0xFF));
+	spi_w((R_LENL << 8) | (t & 0xFF));
+	spi_w((R_LENH << 8) | ((t >> 8) & 0xFF));
+	spi_w((R_VALUE << 8) | 3);                    // VALUE 3: a .reu is going in (no STATUS: still busy)
+	DisableIO();
+}
+
+static void reu_load(const char *path)
+{
+	unsigned long t0 = GetTimer(0);
+	if (!octo_file_send(path, 0x81, reu_progress))
+	{
+		os_log("  REU %s could not be read whole - the MiSTer's own load instead", path);
+		c64_open_file(path, 0x81);
+	}
+	else os_log("  REU in, %lu ms, no OSD bar", GetTimer(0) - t0);
+	reu_in = path;
+}
