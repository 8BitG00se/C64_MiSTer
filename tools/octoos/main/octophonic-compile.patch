+	case 0x15: cmd_go(); break;
+	case 0x16: cmd_prgvram(name); break;
 	case 0x0F: cmd_shell(); break;
 	case 0x12: cmd_menu(); break;
 	default:   mb_reply(E_BADCMD, 0); break;
