+// ------------------------------------------------------------------------------------- COMPILE
+// OCTOCODE's F1: the source to <name>.asm, ACME in a thread, its messages as a log the 6502 reads
+// a line at a time (COMPLOG), the program into RAM (GO). See docs/OCTOOS.md.
+#include <thread>
+#include <mutex>
+#include "../../shmem.h"
+#define COMP_W     36                    // the editor's box is 36 characters wide
+#define VRAM_DDR3  0x32000000
+#define VSRC       0xFE0000              // where the editor puts its copy of the source
+#define OS_ACME    OS_DIR "/acme"
+static std::mutex comp_mx;
+static std::vector<std::string> comp_log;
+static int comp_state = 0, comp_err = 0;     // 0 running (or never), 1 good, 2 errors; first error's line
+static std::string comp_dir, comp_base;
+
+static void comp_add(const std::string &s0)  // (comp_mx held) wrapped at the box's width
+{
+	std::string s = s0; int first = 1;
+	while (!s.empty())
+	{
+		size_t w = first ? COMP_W : COMP_W - 2, k = s.size() < w ? s.size() : w;
+		if (s.size() > w) { size_t b = k; while (b > w / 2 && s[b] != ' ') b--; if (s[b] == ' ') k = b; }
+		comp_log.push_back((first ? "" : "  ") + s.substr(0, k));
+		s.erase(0, k); while (!s.empty() && s[0] == ' ') s.erase(0, 1);
+		first = 0;
+	}
+}
+
+static int comp_p2a(uint8_t c)               // PETSCII (upper/lower case set) to ASCII
+{
+	if (c >= 0x41 && c <= 0x5A) return c + 0x20;
+	if (c >= 0xC1 && c <= 0xDA) return c - 0x80;
+	if (c >= 0x61 && c <= 0x7A) return c - 0x20;
+	if (c >= 0x20 && c <= 0x40) return c;
+	switch (c) { case 0x5B: return '['; case 0x5D: return ']'; case 0x5C: return '\\'; case 0x5E: return '^';
+	             case 0x5F: case 0xA4: return '_'; case 0xDB: return '{'; case 0xDD: return '}';
+	             case 0xDC: return '|'; case 0xDE: return '~'; case 0xA0: return ' '; }
+	return '?';
+}
+static uint8_t comp_a2p(int c)
+{
+	if (c >= 'a' && c <= 'z') return c - 0x20;
+	if (c >= 'A' && c <= 'Z') return c + 0x80;
+	if (c >= 0x20 && c <= 0x40) return c;
+	switch (c) { case '[': return 0x5B; case ']': return 0x5D; case '\\': return 0x5C; case '^': return 0x5E;
+	             case '_': return 0x5F; case '{': return 0xDB; case '}': return 0xDD; case '|': return 0xDC;
+	             case '~': return 0xDE; case '\t': return ' '; }
+	return '?';
+}
+
+static void comp_line(char *s)               // (comp_mx held) one line of ACME's output
+{
+	size_t n = strlen(s);
+	while (n && (s[n - 1] == '\n' || s[n - 1] == '\r' || s[n - 1] == ' ')) s[--n] = 0;
+	if (!n) return;
+	char buf[600];
+	int isE = !strncmp(s, "Error - ", 8) || !strncmp(s, "Serious error - ", 16), isW = !strncmp(s, "Warning - ", 10);
+	if (isE || isW)
+	{
+		const char *l = strstr(s, ", line "), *m = strstr(s, "): ");
+		int line = l ? atoi(l + 7) : 0;
+		const char *msg = m ? m + 3 : s;
+		if (isW && strstr(msg, "Output file already chosen")) return;
+		if (isE && !comp_err && line) comp_err = line;
+		if (line) snprintf(buf, sizeof(buf), "%s line %d: %s", isE ? "Error" : "Warning", line, msg);
+		else snprintf(buf, sizeof(buf), "%s: %s", isE ? "Error" : "Warning", msg);
+		comp_add(buf);
+		return;
+	}
+	unsigned a = 0, b = 0, bytes = 0;
+	if (sscanf(s, "Saving %u (0x%*x) bytes (0x%x - 0x%x exclusive)", &bytes, &a, &b) == 3)
+	{
+		snprintf(buf, sizeof(buf), "Made %s.prg: %u bytes, $%04X-$%04X", comp_base.c_str(), bytes, a, b - 1);
+		comp_add(buf);
+		return;
+	}
+	comp_add(s);
+}
+
+static void comp_thread()                    // ACME, its output line by line into the log
+{
+	std::string prg = comp_dir + "/" + comp_base + ".prg";
+	unlink(prg.c_str());
+	char cmd[2048];
+	snprintf(cmd, sizeof(cmd), "cd '%s' && '%s' -v1 -f cbm -o '%s.prg' -Wno-label-indent --maxerrors 10 '%s.asm' 2>&1",
+		comp_dir.c_str(), OS_ACME, comp_base.c_str(), comp_base.c_str());
+	FILE *p = popen(cmd, "r");
+	int code = -1;
+	if (p)
+	{
+		char line[1024];
+		while (fgets(line, sizeof(line), p)) { std::lock_guard<std::mutex> g(comp_mx); comp_line(line); }
+		int st = pclose(p);
+		code = st == -1 ? -1 : ((st >> 8) & 255) == 127 ? -1 : (st >> 8) & 255;
+	}
+	struct stat sb;
+	std::lock_guard<std::mutex> g(comp_mx);
+	if (code < 0) comp_add("Error: can't start ACME - " OS_ACME " is missing");
+	else if (code || stat(prg.c_str(), &sb)) {
+		char buf[80];
+		if (comp_err) snprintf(buf, sizeof(buf), "Not compiled. First error: line %d", comp_err);
+		else snprintf(buf, sizeof(buf), "Not compiled.");
+		comp_add(buf);
+	}
+	else comp_add("OK - compiled.");
+	comp_state = (code == 0 && !stat(prg.c_str(), &sb)) ? 1 : 2;
+	os_log("COMPILE %s in %s: exit %d, first error line %d", comp_base.c_str(), comp_dir.c_str(), code, comp_err);
+}
+
+static void cmd_compile(const char *name, int len, int arg)
+{
+	{
+		std::lock_guard<std::mutex> g(comp_mx);
+		if (comp_state == 0 && !comp_log.empty()) { mb_reply(E_CANTRUN, 0); return; }   // one at a time
+	}
+	std::string base;
+	for (const char *c = name; *c && *c != '.' && base.size() < 32; c++)
+	{
+		int ch = tolower((unsigned char)*c);
+		if (isalnum(ch) || ch == '-' || ch == '_' || ch == ' ') base.push_back((char)ch);
+	}
+	if (base.empty()) base = "source";
+	if (len <= 0 || !(arg & 1)) { mb_reply(E_NOTFOUND, 0); return; }   // (the MiSTer only has the VRAM copy)
+	std::string dir = disk8.empty() ? std::string(OS_TOP "/") + cwd : disk8.substr(0, disk8.rfind('/'));
+	// the source: OctoVIC's VRAM in DDR3, where the editor copied it
+	uint8_t *v = (uint8_t *)shmem_map(VRAM_DDR3 + VSRC, len);
+	if (!v) { mb_reply(E_READ, 0); return; }
+	std::string txt; int lines = 0;
+	for (int i = 0; i < len; i++)
+	{
+		if (v[i] == 0x0D) { txt.push_back('\n'); lines++; }
+		else if (v[i] != 0x0A) txt.push_back((char)comp_p2a(v[i]));
+	}
+	shmem_unmap(v, len);
+	std::lock_guard<std::mutex> g(comp_mx);
+	comp_log.clear(); comp_err = 0; comp_state = 0; comp_dir = dir; comp_base = base;
+	std::string asmf = dir + "/" + base + ".asm";
+	FILE *f = fopen(asmf.c_str(), "wb");
+	if (!f) { comp_add("Error: can't write " + base + ".asm in that folder"); comp_state = 2; mb_reply(ST_DONE, 0, 0, 0); return; }
+	fwrite(txt.data(), 1, txt.size(), f); fclose(f);
+	char buf[96];
+	snprintf(buf, sizeof(buf), "Saved %s.asm, %d lines", base.c_str(), lines); comp_add(buf);
+	comp_add("ACME " + base + ".asm");
+	std::thread(comp_thread).detach();
+	mb_reply(ST_DONE, 0, (int)comp_log.size(), 0);
+}
+
+static void cmd_complog(uint16_t addr, int from, int max)
+{
+	std::lock_guard<std::mutex> g(comp_mx);
+	if (comp_log.empty() && !comp_state) { mb_reply(E_NOTFOUND, 0); return; }
+	if (!max) max = 8;
+	std::vector<uint8_t> out;
+	for (int i = from; i < (int)comp_log.size() && i < from + max; i++)
+	{
+		for (char c : comp_log[i]) out.push_back(comp_a2p((unsigned char)c));
+		out.push_back(0x0D);
+	}
+	out.push_back(0);
+	ram_write(addr, out.data(), out.size());
+	mb_reply(ST_DONE, comp_err, (int)comp_log.size(), comp_state);
+}
+
+static void cmd_go()
+{
+	if (comp_base.empty() || comp_state != 1) { mb_reply(E_NOTFOUND, 0); return; }
+	std::string prg = comp_dir + "/" + comp_base + ".prg";
+	FILE *f = fopen(prg.c_str(), "rb");
+	if (!f) { mb_reply(E_NOTFOUND, 0); return; }
+	static uint8_t buf[65540];
+	size_t n = fread(buf, 1, sizeof(buf), f); fclose(f);
+	if (n < 3) { mb_reply(E_READ, 0); return; }
+	unsigned at = buf[0] | (buf[1] << 8), end = at + (unsigned)(n - 2);
+	if (at < 0x0400 || end > 0x10000) { mb_reply(E_TOOBIG, 0); return; }   // $0000-$03FF: the 6502's
+	ram_write((uint16_t)at, buf + 2, (uint32_t)(n - 2));
+	os_log("GO %s.prg: $%04X-$%04X", comp_base.c_str(), at, end - 1);
+	mb_reply(ST_DONE, (int)at, (int)(end & 0xFFFF));
+}
+
+
+static void cmd_prgvram(const char *name)    // build 3 of OCTOCODE: the last good program into VRAM $FD0000
+{
+	std::string base;
+	for (const char *c = name; *c && *c != '.' && base.size() < 32; c++)
+	{
+		int ch = tolower((unsigned char)*c);
+		if (isalnum(ch) || ch == '-' || ch == '_' || ch == ' ') base.push_back((char)ch);
+	}
+	std::string dir;
+	{
+		std::lock_guard<std::mutex> g(comp_mx);
+		if (comp_state != 1) { mb_reply(E_NOTFOUND, 0); return; }
+		if (base.empty()) base = comp_base;
+		dir = comp_dir;
+	}
+	std::string prg = dir + "/" + base + ".prg";
+	FILE *f = fopen(prg.c_str(), "rb");
+	if (!f) { mb_reply(E_NOTFOUND, 0); return; }
+	static uint8_t buf[65540];
+	size_t n = fread(buf, 1, sizeof(buf), f); fclose(f);
+	if (n < 3 || n > 65535) { mb_reply(E_READ, 0); return; }
+	uint8_t *v = (uint8_t *)shmem_map(VRAM_DDR3 + 0xFD0000, (uint32_t)n);
+	if (!v) { mb_reply(E_READ, 0); return; }
+	memcpy(v, buf, n);
+	shmem_unmap(v, (uint32_t)n);
+	os_log("PRGVRAM %s.prg: %u bytes", base.c_str(), (unsigned)n);
+	mb_reply(ST_DONE, (int)n);
+}
