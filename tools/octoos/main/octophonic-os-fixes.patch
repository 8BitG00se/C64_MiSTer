+// ------------------------------------------------------------------------- os-fixes: 17, 18
+
+// DRIVE8 ($17): the disk in drive 8, as the core has it (also one mounted from the MiSTer's menu)
+static void cmd_drive8(uint16_t addr)
+{
+	const char *n = get_image_name(0);
+	std::vector<uint8_t> out;
+	int len = 0;
+	if (n) for (; n[len] && len < 32; len++) out.push_back(to_pet(n[len]));
+	out.push_back(0);
+	ram_write(addr ? addr : 0xA000, out.data(), out.size());
+	mb_reply(ST_DONE, len);
+}
+
+// REU ($18): a running program asks for its .reu by name (the next demo, run from OCTOCODE)
+static void cmd_reu(const char *name, int again)
+{
+	std::vector<std::string> dirs;
+	if (!prog_dir.empty()) dirs.push_back(prog_dir);
+	if (!disk8.empty()) dirs.push_back(disk8.substr(0, disk8.rfind('/')));
+	dirs.push_back(std::string(OS_TOP "/") + cwd);
+	std::string want = name, hit;
+	if (want.empty() || want.find('/') != std::string::npos || want.find("..") != std::string::npos) { mb_reply(E_NOTFOUND, 0); return; }
+	for (auto &d : dirs)
+	{
+		DIR *dd = opendir(d.c_str());
+		if (!dd) continue;
+		std::string got;
+		while (struct dirent *de = readdir(dd))
+		{
+			if (!ends_with(de->d_name, ".reu")) continue;
+			if (!strcasecmp(de->d_name, want.c_str()) || !strcasecmp(base_of(de->d_name).c_str(), want.c_str())) { got = de->d_name; break; }
+		}
+		closedir(dd);
+		if (!got.empty()) { hit = d + "/" + got; break; }
+	}
+	if (hit.empty()) { os_log("  REU '%s': not in %s", name, dirs[0].c_str()); mb_reply(E_NOTFOUND, 0); return; }
+	struct stat st;
+	long kb64 = stat(hit.c_str(), &st) ? 0 : (long)((st.st_size + 65535) >> 16);
+	if (hit == reu_in && !again) { os_log("  REU %s is in already", hit.c_str()); mb_reply(ST_DONE, (int)kb64, -1, 4); return; }
+	os_log("  REU %s (asked for by the program)", hit.c_str());
+	reu_load(hit.c_str());                          // VALUE 3 and the blocks while it goes in
+	mb_reply(ST_DONE, (int)kb64, -1, 2);
+}
