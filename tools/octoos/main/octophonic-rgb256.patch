+			rgb_send();
+			snprintf(msg, sizeof(msg), "Gradient: %s", pk_str_name[s2]);
+		}
+	}
+	else if (k == 3)                              // WIN+F8: save the pack as it is now
+	{
+		if (!rgb_is_auto())
+		{
+			std::string bak = rgb_pack + ".bak";       // a hand-made pack is kept once, as it came
+			if (access(bak.c_str(), F_OK)) { FILE *b = fopen(bak.c_str(), "wb"); if (b) { uint8_t t[PK_SIZE]; memcpy(t, rgb_pk, PK_SIZE); memcpy(t + 0x1800, rgb_pk_base, sizeof(rgb_pk_base)); fwrite(t, 1, PK_SIZE, b); fclose(b); } }
+		}
+		int ok = rgb_write_file(rgb_pack, rgb_pk, PK_SIZE);
+		snprintf(msg, sizeof(msg), ok ? "Pack saved" : "Pack NOT saved");
+		rgb_ulog("pack %s %s", ok ? "saved:" : "NOT saved:", rgb_pack.c_str());
+	}
+	else return;
+	os_log("  Remaster key: %s", msg);
+	Info(msg, 1500);
+}
