+// ------------------------------------------------------------ C64RGB 256 (Fix 60, docs/RGB256.md)
+// A game with a recolour pack beside it (<game>.rgb, the same name) starts in the C64RGB 256 core
+// (_Computer/.C64RGB256_<date>.rbf, hidden like the Octophonic core) with its pack; a game without one,
+// picked while the C64RGB 256 core runs, goes back to the Octophonic core. Both are an .mgl written to
+// octophonic/rgb256.mgl and started as the menu starts one - MiSTer's own way of loading a core with files.
+// SHIFT+F1 held in the C64RGB 256 core (the mailbox's poll word, b2) - back to the Octophonic core.
+#define RGB_MGL   OS_DIR "/rgb256.mgl"
+
+static std::string rgb_pack_of(const std::string &game)
+{
+	size_t sl = game.rfind('/');
+	std::string dir = game.substr(0, sl), base = base_of(game.substr(sl + 1));
+	DIR *d = opendir(dir.c_str());
+	if (!d) return "";
+	std::string hit;
+	while (struct dirent *de = readdir(d))
+	{
+		std::string n = de->d_name;
+		if (ends_with(n.c_str(), ".rgb") && !strcasecmp(base_of(n).c_str(), base.c_str())) { hit = dir + "/" + n; break; }
+	}
+	closedir(d);
+	return hit;
+}
+
+static int rgb_core_there()
+{
+	DIR *d = opendir(OS_TOP "/_Computer");
+	if (!d) return 0;
+	int n = 0;
+	while (struct dirent *de = readdir(d))
+		if (!strncasecmp(de->d_name, ".C64RGB256_", 11) && ends_with(de->d_name, ".rbf")) n++;
+	closedir(d);
+	return n;
+}
+
+static void xml_attr(FILE *f, const char *s)      // a path, safe inside an XML attribute
+{
+	for (; *s; s++)
+	{
+		if (*s == '&') fputs("&amp;", f);
+		else if (*s == '"') fputs("&quot;", f);
+		else if (*s == '<') fputs("&lt;", f);
+		else if (*s == '>') fputs("&gt;", f);
+		else fputc(*s, f);
+	}
+}
+
+// start a core (rbf: "_Computer/.C64RGB256" or "_Computer/.C64_Octophonic") with the pack and the game
+static void rgb_switch(const char *rbf, const char *pack, const char *game)
+{
+	FILE *f = fopen(RGB_MGL, "w");
+	if (!f) { os_log("  RGB 256: cannot write %s", RGB_MGL); return; }
+	fprintf(f, "<mistergamedescription>\n    <rbf>%s</rbf>\n    <setname same_dir=\"1\">Octophonic64</setname>\n", rbf);
+	if (pack && pack[0]) { fputs("    <file delay=\"1\" type=\"f\" index=\"4\" path=\"", f); xml_attr(f, pack); fputs("\"/>\n", f); }
+	if (game && game[0])
+	{
+		int disk = ends_with(game, ".d64") || ends_with(game, ".g64") || ends_with(game, ".t64") || ends_with(game, ".d81");
+		fprintf(f, "    <file delay=\"1\" type=\"%s\" index=\"%s\" path=\"", disk ? "s" : "f", disk ? "0" : "1");
+		xml_attr(f, game); fputs("\"/>\n", f);
+	}
+	fputs("</mistergamedescription>\n", f);
+	fclose(f);
+	os_log("  RGB 256: %s, pack %s, game %s", rbf, pack && pack[0] ? pack : "-", game && game[0] ? game : "-");
+	xml_load(RGB_MGL);
+}
+
+// back to the Octophonic core - its launcher, as at power-on (SHIFT+F1 held, or Esc/CTRL+F12)
+static void rgb_home()
+{
+	char full[1024];
+	snprintf(full, sizeof(full), "%s%s%s", os_boot[0] == '/' ? "" : OS_TOP, os_boot[0] == '/' ? "" : "/", os_boot);
+	os_log("RGB 256: back to the Octophonic core (%s)", full);
+	octo_oled_logo(1);
+	if (ends_with(full, ".mgl") && !access(full, R_OK)) xml_load(full);
+	else rgb_switch("_Computer/.C64_Octophonic", NULL, NULL);
+}
