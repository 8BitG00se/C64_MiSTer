+		snprintf(msg, sizeof(msg), "Grading: %s", pk_grade_name[g]);
+	}
+	else if (k == 2)                              // WIN+F7: the gradient strength
+	{
+		if (!rgb_is_auto()) snprintf(msg, sizeof(msg), "Gradient: auto packs only");
+		else
+		{
+			int s2 = (rgb_pk[0x0C] + 1) % PK_NSTR;
+			char title[33] = {0};
+			memcpy(title, rgb_pk + 0x90, 32);
