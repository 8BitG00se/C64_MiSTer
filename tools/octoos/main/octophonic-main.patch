+void octo_poll();
+// F12 pressed (1) or let go (0): held for 2 s, it opens the MiSTer menu
+void octo_f12(int press);
+// in user_io.cpp: let the core's F12 go and open the MiSTer menu
+void user_io_octo_menu();
+
+#endif
