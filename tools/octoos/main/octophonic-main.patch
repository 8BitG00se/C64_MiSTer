@@ -0,0 +1,1391 @@
+// OCTOPHONIC OS (milestone 1, build 2) - by Mong00se.
+//
+// With /media/fat/octophonic/os.ini on the card, the MiSTer starts straight into the Octophonic 64
+// core instead of the menu, plain F12 goes to the C64 (Win+F12, or F12 held for 2 seconds, opens the
+// MiSTer menu), and the 6502 asks Main for things through a mailbox in the core ($D6F0-$D6FF).
+//
+// The C64 side is only a front end. Everything it asks for is done by the same Main code the MiSTer
+// menu uses: folders are read with ScanDirectory (the menu's own file list, same filter, same sort,
+// zips as folders), programs and cartridges are loaded with c64_open_file and the menu's indexes,
+// disks are mounted with user_io_file_mount, chip files are loaded and remembered the way the
+// menu's "FC" entries do it, options are changed with user_io_status_set and saved with
+// user_io_status_save, and a chip preset (.mgl) is started with xml_load, as picking it in the menu.
+//
+//   01 DIR      a page of the folder as ready-to-print PETSCII text at ADDR (the @ command)
+//   02 CHDIR    change folder (NAME; ".." up, "" or "/" back to the start folder)
+//   03 LOAD     file NAME into C64 RAM at its own load address (ARG b0: at ADDR), no reset
+//   04 RUN      file NAME, as picking it in the menu (the / command)
+//   05 INFO     a line of text about the OS at ADDR
+//   06 LIST     for the browser: the path (40 bytes), then 32-byte records from entry LEN, VALUE of
+//               them; RESULT = entries in all, VALUE = how many were written
+//   07 OPEN     entry LEN of the list, as picking it in the menu: a folder (VALUE $10), a disk into
+//               drive 8 (VALUE 8), a program or cartridge loaded and run (VALUE 1, the core resets)
+//   08 SETLIST  the settings page: 40-byte lines (label 20, value 20) at ADDR; RESULT = how many
+//   09 SETSTEP  setting ARG to its next (VALUE 1) or previous (VALUE $FF) choice; applied and saved,
+//               except the chip preset, which only changes on SETAPPLY
+//   0A SETAPPLY start the chosen chip preset (and keep it as the one the OS boots with)
+//   0B NOSHARE  stop waiting for the network share: the SD card's folder
+//   0C SHOT     a screenshot (MiSTer's own: the scaler's picture, as Win+PrtScn) saved as
+//               <share>/C64/Octophonic/Screenshots/NAME.png (no share: /media/fat/screenshots/Octophonic)
+//               - answered at once, saved in the background, at most one a second. NET b7 is set
+//               while the picture is being copied out of video memory, b6 while the PNG is written
+//   0D APPEND   VALUE $FF: file ARG (0-3) is NAME (a path under Screenshots, folders made as needed);
+//               otherwise NAME's text goes on the end of file ARG - VALUE b0 set: no new line yet
+//               (a long line in several pieces)
+//   0F SHELL    the browser (octophonic/SHELL.PRG) into RAM at its own load address
+//
+// Every request is written to /media/fat/octophonic/os.log (what, where, the result, how long).
+// Main sees the mailbox through hps_io's extension bus (rtl/octovic/octo_os.sv): 0x70 poll,
+// 0x71 read the registers and the name, 0x72 write registers. Without os.ini none of this runs and
+// Main behaves exactly as the stock one.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#include <strings.h>
+#include <ctype.h>
