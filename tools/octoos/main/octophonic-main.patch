+#include <vector>
+#include <string>
+#include <algorithm>
+#include <fcntl.h>
+
+#include "../../spi.h"
+#include "../../user_io.h"
+#include "../../fpga_io.h"
+#include "../../file_io.h"
+#include "../../hardware.h"
+#include "../arcade/mra_loader.h"
+#include "../c64/c64.h"
+#include "../../scaler.h"
+#include "../../cfg.h"
+#include "octo.h"
+
+#define OS_DIR      "/media/fat/octophonic"
+#define OS_INI      OS_DIR "/os.ini"
+#define OS_LOG      OS_DIR "/os.log"
+#define OS_SHELL    OS_DIR "/SHELL.PRG"
+#define OS_FLAG     "/tmp/octoos_booted"
+#define OS_CWD      "/tmp/octoos_cwd"      // the folder, kept while Main restarts with a new core
+#define OS_TOP      "/media/fat"
+#define OS_EXTS     "PRGCRTREUD64G64T64D81"   // the core's own menu: F1 PRGCRTREU and S0 D64G64T64D81
+#define CHIP_DIR    "games/C64/My Chips"
+
+#define UIO_OCTO_POLL  0x70
+#define UIO_OCTO_READ  0x71
+#define UIO_OCTO_WRITE 0x72
+#define OCTO_MAGIC     0x6F
+
+#define RAW_INDEX      0x0A     // the core's "raw RAM" download: no reset, no BASIC pointers
+
+enum { R_CMD, R_STATUS, R_ADDRL, R_ADDRH, R_LENL, R_LENH, R_ARG, R_VALUE, R_NAMELEN, R_9, R_RESL, R_RESH, R_VER, R_SEQ, R_RSEQ };
+enum { ST_IDLE = 0, ST_BUSY = 1, ST_DONE = 2,
+       E_NOTFOUND = 0x81, E_NOTDIR = 0x82, E_TOOBIG = 0x83, E_READ = 0x84, E_CANTRUN = 0x85, E_NOTCONN = 0x86, E_BADCMD = 0x8F };
+
+static int  os_enabled = 0;
+static char os_boot[512] = "_Computer/Octophonic 64.mgl";
+static char os_start[512] = "";
+static char os_startin[16] = "";           // "net", "sd", "last" ("": network if there is one, else SD)
+static int  os_active = 0;
+static char cwd[1024];                   // the folder, relative to /media/fat ("" is the top)
+static unsigned long poll_timer = 0;
+static unsigned long f12_time = 0;       // F12 held down since (the MiSTer menu after 2 s)
+static std::string reu_in;                // the .reu last put in the REU (no second 16 MB load of it)
+static int  last_status = 0;             // the reply of the request being logged
+static uint8_t cur_seq = 0;              // the 6502's number for the request being answered
+
+// ------------------------------------------------------------------------------------------ log
+
+static void os_log(const char *fmt, ...)
+{
+	struct stat st;
+	if (!stat(OS_LOG, &st) && st.st_size > 64 * 1024) rename(OS_LOG, OS_LOG ".1");
+	FILE *f = fopen(OS_LOG, "a");
+	if (!f) return;
+	time_t t = time(0);
+	char ts[32];
+	struct tm *tm = localtime(&t);
+	if (tm->tm_year < 100)                       // the clock isn't set yet (no network time): uptime
+	{
+		struct timespec up;
+		clock_gettime(CLOCK_MONOTONIC, &up);
+		snprintf(ts, sizeof(ts), "[up %5lds]", (long)up.tv_sec);
+	}
+	else strftime(ts, sizeof(ts), "%Y-%m-%d %H:%M:%S", tm);
+	fprintf(f, "%s ", ts);
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fputc('\n', f);
+	fclose(f);
+}
+
+// ------------------------------------------------------------------------------------------ ini
+
+static void read_ini()
+{
+	os_enabled = 0;
+	FILE *f = fopen(OS_INI, "r");
+	if (!f) return;
+	os_enabled = 1;
+	char line[600];
+	while (fgets(line, sizeof(line), f))
+	{
+		char *e = line + strlen(line);
+		while (e > line && (e[-1] == '\n' || e[-1] == '\r' || e[-1] == ' ' || e[-1] == '\t')) *--e = 0;
+		char *p = line;
+		while (*p == ' ' || *p == '\t') p++;
+		if (*p == ';' || *p == '#' || !*p) continue;
+		char *eq = strchr(p, '=');
+		if (!eq) continue;
+		*eq = 0;
+		const char *v = eq + 1;
+		if (!strcasecmp(p, "enabled")) os_enabled = atoi(v) != 0;
+		else if (!strcasecmp(p, "boot")) snprintf(os_boot, sizeof(os_boot), "%s", v);
+		else if (!strcasecmp(p, "start")) snprintf(os_start, sizeof(os_start), "%s", v);
+		else if (!strcasecmp(p, "startin")) snprintf(os_startin, sizeof(os_startin), "%s", v);
+	}
+	fclose(f);
+}
+
+// os.ini with KEY= changed, everything else kept as it is
+static void write_key(const char *key, const char *val)
+{
+	char k[32];
+	snprintf(k, sizeof(k), "%s=", key);
+	std::vector<std::string> lines;
+	int done = 0;
+	FILE *f = fopen(OS_INI, "r");
+	if (f)
+	{
+		char line[600];
+		while (fgets(line, sizeof(line), f))
+		{
+			const char *p = line;
+			while (*p == ' ' || *p == '\t') p++;
+			if (!strncasecmp(p, k, strlen(k))) { lines.push_back(std::string(k) + val + "\n"); done = 1; }
+			else lines.push_back(line);
+		}
+		fclose(f);
+	}
+	if (!done) lines.push_back(std::string(k) + val + "\n");
+	f = fopen(OS_INI ".new", "w");
+	if (!f) return;
+	for (auto &l : lines) fputs(l.c_str(), f);
+	fclose(f);
+	rename(OS_INI ".new", OS_INI);
+}
+
+static void write_boot(const char *boot)
+{
+	write_key("boot", boot);
+	snprintf(os_boot, sizeof(os_boot), "%s", boot);
+}
+
+static int ends_with(const char *s, const char *ext)
+{
+	size_t a = strlen(s), b = strlen(ext);
+	return a >= b && !strcasecmp(s + a - b, ext);
+}
+
+// ----------------------------------------------------------------------------------------- boot
+
+void octo_os_boot(const char *core_path)
+{
+	if (core_path && core_path[0]) return;          // a core was asked for: leave it alone
+	read_ini();
+	if (!os_enabled) return;
+	if (!access(OS_FLAG, F_OK)) return;             // only once per power-on: the menu stays reachable
+	FILE *fl = fopen(OS_FLAG, "w");
+	if (fl) fclose(fl);
+
+	char full[1024];
+	snprintf(full, sizeof(full), "%s%s%s", os_boot[0] == '/' ? "" : OS_TOP, os_boot[0] == '/' ? "" : "/", os_boot);
+	os_log("boot: %s", full);
+	printf("Octophonic OS: starting %s\n", full);
+	if (ends_with(full, ".mgl") && !access(full, R_OK)) { xml_load(full); return; }
+	if (ends_with(full, ".rbf") && !access(full, R_OK)) { fpga_load_rbf(full); return; }
+
+	// no launcher: the newest hidden Octophonic core in _Computer
+	DIR *d = opendir(OS_TOP "/_Computer");
+	if (!d) return;
+	char best[256] = "";
+	while (struct dirent *de = readdir(d))
+	{
+		if (!strncasecmp(de->d_name, ".C64_Octophonic", 15) && ends_with(de->d_name, ".rbf") &&
+			strcmp(de->d_name, best) > 0) snprintf(best, sizeof(best), "%s", de->d_name);
+	}
+	closedir(d);
+	if (!best[0]) { os_log("boot: no core found, staying in the menu"); return; }
+	snprintf(full, sizeof(full), OS_TOP "/_Computer/%s", best);
+	os_log("boot: %s (launcher missing)", full);
+	fpga_load_rbf(full);
+}
+
+// -------------------------------------------------------------------------------------- mailbox
+
+static uint16_t mb_poll()
+{
+	return spi_uio_cmd(UIO_OCTO_POLL);
+}
+
+static void mb_read(uint8_t *reg, char *name)
+{
+	spi_uio_cmd_cont(UIO_OCTO_READ);
+	for (int i = 0; i < 16; i++) reg[i] = (uint8_t)spi_w(0);
+	for (int i = 0; i < 32; i++) name[i] = (char)spi_w(0);
+	DisableIO();
+	int n = reg[R_NAMELEN];
+	if (n > 32) n = 32;
+	name[n] = 0;
+}
+
+static void mb_reply(int status, int res, int len = -1, int value = -1)
+{
+	last_status = status;
+	spi_uio_cmd_cont(UIO_OCTO_WRITE);
+	spi_w((R_RSEQ << 8) | cur_seq);               // first: the core drops the whole reply if the
+	                                              // 6502 has moved on to a newer request
+	spi_w((R_RESL << 8) | (res & 0xFF));
+	spi_w((R_RESH << 8) | ((res >> 8) & 0xFF));
+	if (len >= 0)
+	{
+		spi_w((R_LENL << 8) | (len & 0xFF));
+		spi_w((R_LENH << 8) | ((len >> 8) & 0xFF));
+	}
+	if (value >= 0) spi_w((R_VALUE << 8) | (value & 0xFF));
+	spi_w((R_STATUS << 8) | (status & 0xFF));     // last: this one ends the request
+	DisableIO();
+}
+
+struct Entry { std::string name; int dir; int up; std::string target; int na; std::string size; };
+
+// ---------------------------------------------------------------------- drives and the network
+//
+// The browser's top level is the drives: SD CARD (games/C64 on the card), NETWORK (the C64 folder
+// on a network share, when this MiSTer has one set up) and USB n (games/C64 on a USB stick).
+// Folders are kept relative to /media/fat, as the menu's are ("../network/C64" for /media/network);
+// "*" is the drives level.
+//
+// The network: Main checks every second whether a share is mounted (cifs/smb/nfs in /proc/mounts)
+// and tells the core (the mailbox's NET register): 0 no share set up, 1 set up but not there yet
+// and the OS is waiting to open it, 3 not there and not waited for, 2 there. While the OS waits (a
+// share that is still connecting at power-on), the moment it appears the folder becomes the
+// share's C64 folder; after 60 seconds, or when the C64 side says so, it stays on the SD card.
+
+#define DRIVES      "*"
+#define NET_SEEN    OS_DIR "/net.seen"      // a share has been seen on this MiSTer: wait for it
+#define OS_LAST     OS_DIR "/last.txt"      // the last folder, for "start in: last used"
+
+static int  net_conf = 0;            // a share is set up on this MiSTer
+static int  net_state = 0;           // what NET says
+static char net_root[1024] = "";     // the share's C64 folder (relative), when it is there
+static int  net_wait = 0;            // waiting to open the share as it appears
+static unsigned long net_deadline = 0, net_timer = 0;
+
+static int dir_at(const char *rel)
+{
+	char full[1100];
+	snprintf(full, sizeof(full), OS_TOP "/%s", rel);
+	struct stat st;
+	return !stat(full, &st) && S_ISDIR(st.st_mode);
+}
+
+// an absolute path as one relative to /media/fat ("/media/network/C64" -> "../network/C64")
+static std::string rel_of(const std::string &abs)
+{
+	if (abs == OS_TOP) return "";
+	if (!abs.compare(0, strlen(OS_TOP) + 1, OS_TOP "/")) return abs.substr(strlen(OS_TOP) + 1);
+	if (!abs.compare(0, 7, "/media/")) return "../" + abs.substr(7);
+	return ".." + abs;                                      // (somewhere else: from / via ..)
+}
+
+static std::string sd_root()
+{
+	if (dir_at("games/C64")) return "games/C64";
+	if (dir_at("games")) return "games";
+	return "";
+}
+
+static int file_has_server(const char *path)
+{
+	FILE *f = fopen(path, "r");
+	if (!f) return 0;
+	char line[512];
+	int yes = 0;
+	while (fgets(line, sizeof(line), f))
+	{
+		const char *p = line;
+		while (*p == ' ' || *p == '\t') p++;
+		if (strncmp(p, "SERVER=", 7)) continue;
+		p += 7;
+		if (*p == '"') p++;
+		if (*p && *p != '"' && *p != '\n' && *p != '\r' && *p != ' ') yes = 1;
+	}
+	fclose(f);
+	return yes;
+}
+
+// the network shares mounted now (mount points)
+static void net_mounts(std::vector<std::string> &m)
+{
+	m.clear();
+	FILE *f = fopen("/proc/mounts", "r");
+	if (!f) return;
+	char dev[512], mp[512], type[64];
+	while (fscanf(f, "%511s %511s %63s %*[^\n]", dev, mp, type) == 3)
+		if (!strcmp(type, "cifs") || !strcmp(type, "smb3") || !strncmp(type, "nfs", 3)) m.push_back(mp);
+	fclose(f);
+	// the ones in /media/fat first: the menu's own places
+	std::stable_sort(m.begin(), m.end(), [](const std::string &a, const std::string &b) {
+		return (a.compare(0, 10, "/media/fat") == 0) > (b.compare(0, 10, "/media/fat") == 0); });
+}
+
+static int net_configured()
+{
+	std::vector<std::string> m;
+	net_mounts(m);
+	if (!m.empty() || !access(NET_SEEN, F_OK)) return 1;
+	if (file_has_server(OS_TOP "/Scripts/cifs_mount.ini") || file_has_server(OS_TOP "/Scripts/cifs_mount.sh")) return 1;
+	if (dir_at("cifs") || dir_at("games/00-NETWORK")) return 1;
+	return 0;
+}
+
+// the share's C64 folder if a share is mounted (relative to /media/fat), "" if not
+static std::string net_find()
+{
+	std::vector<std::string> m;
+	net_mounts(m);
+	if (m.empty()) return "";
+	if (os_start[0])                                         // os.ini's start= on the share
+	{
+		std::string st = rel_of(os_start[0] == '/' ? os_start : std::string(OS_TOP "/") + os_start);
+		for (auto &mp : m)
+			if (!rel_of(os_start[0] == '/' ? os_start : std::string(OS_TOP "/") + os_start).compare(0, rel_of(mp).size(), rel_of(mp)) && dir_at(st.c_str())) return st;
+	}
+	for (auto &mp : m)
+	{
+		std::string r = rel_of(mp);
+		for (const char *sub : { "/C64", "/games/C64", "/Games/C64", "/c64" })
+			if (dir_at((r + sub).c_str())) return r + sub;
+	}
+	return rel_of(m[0]);
+}
+
+static int net_sent = -1;            // the NET byte as last written to the core
+static int shot_bits()
+{
+	int st = screenshot_state();
+	return st == 2 ? 0x80 : st == 1 ? 0x40 : 0;
+}
+
+static void net_publish()
+{
+	int b = (net_state & 3) | shot_bits();
+	spi_uio_cmd_cont(UIO_OCTO_WRITE);
+	spi_w((0x0F << 8) | b);
+	DisableIO();
+	net_sent = b;
+}
+
+static void net_update()
+{
+	std::string r = net_find();
+	if (!r.empty())
+	{
+		snprintf(net_root, sizeof(net_root), "%s", r.c_str());
+		if (access(NET_SEEN, F_OK)) { FILE *f = fopen(NET_SEEN, "w"); if (f) fclose(f); }
+		net_conf = 1;
+	}
+	if (net_wait && !r.empty())
+	{
+		net_wait = 0;
+		snprintf(cwd, sizeof(cwd), "%s", net_root);
+		snprintf(os_start, sizeof(os_start), "%s", net_root);
+		os_log("network: the share is there - folder /%s", cwd);
+	}
+	if (net_wait && CheckTimer(net_deadline))
+	{
+		net_wait = 0;
+		os_log("network: no share after 60 s - staying on the SD card");
+	}
+	int st = !net_conf ? 0 : !r.empty() ? 2 : net_wait ? 1 : 3;
+	if (st != net_state) os_log("network: state %d -> %d", net_state, st);
+	net_state = st;
+	net_publish();
+}
+
+void octo_os_core_init()
+{
+	os_active = 0;
+	read_ini();
+	if (!os_enabled || !is_c64()) return;
+	uint16_t w = mb_poll();
+	if ((w >> 8) != OCTO_MAGIC) { os_log("core: no mailbox (poll %04X) - the OS is off for this core", w); return; }
+	os_active = 1;
+
+	// where to start: os.ini's startin= (network, SD card, the last folder); without it the
+	// network when this MiSTer has a share, else the SD card. start= is the share's folder, if set.
+	if (os_start[0] && !strncmp(os_start, OS_TOP "/games/C64", strlen(OS_TOP "/games/C64")) && !os_start[strlen(OS_TOP "/games/C64")])
+		os_start[0] = 0;                                     // build 1/2's default: not a choice
+	net_conf = net_configured();
+	std::string nr = net_find();
+	if (!nr.empty()) snprintf(net_root, sizeof(net_root), "%s", nr.c_str());
+	const char *mode = os_startin[0] ? os_startin : (net_conf ? "net" : "sd");
+	snprintf(cwd, sizeof(cwd), "%s", sd_root().c_str());
+	net_wait = 0;
+	struct stat st;
+	char full[1100];
+	if (!strcasecmp(mode, "last"))
+	{
+		FILE *fl = fopen(OS_LAST, "r");
+		char was[1024] = {};
+		if (fl) { if (fgets(was, sizeof(was), fl)) was[strcspn(was, "\r\n")] = 0; fclose(fl); }
+		if (was[0] && dir_at(was)) snprintf(cwd, sizeof(cwd), "%s", was);
+		else if (was[0] && net_conf && nr.empty()) { net_wait = 1; }
+	}
+	else if (!strcasecmp(mode, "net") && net_conf)
+	{
+		if (!nr.empty()) snprintf(cwd, sizeof(cwd), "%s", nr.c_str());
+		else net_wait = 1;                                    // the share is still connecting
+	}
+	if (net_wait) net_deadline = GetTimer(60000);
+	snprintf(os_start, sizeof(os_start), "%s", cwd);
+	// where the browser was before this core (re)started - a preset, or Main starting again
+	FILE *fc = fopen(OS_CWD, "r");
+	if (fc)
+	{
+		char was[1024] = {};
+		if (fgets(was, sizeof(was), fc))
+		{
+			was[strcspn(was, "\r\n")] = 0;
+			snprintf(full, sizeof(full), OS_TOP "/%s", was);
+			if (!strcmp(was, DRIVES) || (!stat(full, &st) && S_ISDIR(st.st_mode))) { snprintf(cwd, sizeof(cwd), "%s", was); net_wait = 0; }
+		}
+		fclose(fc);
+	}
+	net_state = !net_conf ? 0 : !nr.empty() ? 2 : net_wait ? 1 : 3;
+	net_publish();
+	os_log("core: OS active, folder /%s, start in %s, network %s%s", cwd, mode,
+		!net_conf ? "none" : nr.empty() ? "not there yet" : nr.c_str(), net_wait ? " (waiting for it)" : "");
+	printf("Octophonic OS: active, folder /%s\n", cwd);
+}
+
+int octo_os_active()
+{
+	return os_active;
+}
+
+// -------------------------------------------------------------------------------------- helpers
+
+// into C64 RAM at addr, through the core's raw download (2-byte address, then the bytes)
+static void ram_write(uint16_t addr, const uint8_t *data, uint32_t len)
+{
+	uint8_t hdr[2] = { (uint8_t)(addr & 0xFF), (uint8_t)(addr >> 8) };
+	user_io_set_index(RAW_INDEX);
+	user_io_set_download(1);
+	user_io_file_tx_data(hdr, 2);
+	uint32_t off = 0;
+	while (off < len)
+	{
+		uint32_t chunk = len - off;
+		if (chunk > 4096) chunk = 4096;
+		user_io_file_tx_data(data + off, chunk);
+		off += chunk;
+	}
+	user_io_set_download(0);
+}
+
+static uint8_t to_pet(char c)
+{
+	unsigned char u = (unsigned char)c;
+	if (u >= 'a' && u <= 'z') return u - 32;
+	if (u >= 0x20 && u <= 0x5D) return u;
+	if (u == '_') return 0xA4;
+	return '?';
+}
+
+static void from_pet(const char *in, char *out, int max)
+{
+	int n = 0;
+	for (; *in && n < max - 1; in++)
+	{
+		unsigned char u = (unsigned char)*in;
+		if (u >= 0xC1 && u <= 0xDA) u = u - 0xC1 + 'a';
+		else if (u == 0xA4) u = '_';
+		else if (u < 0x20 || u > 0x7E) continue;
+		out[n++] = (char)u;
+	}
+	out[n] = 0;
+	while (n && out[n - 1] == ' ') out[--n] = 0;  // trailing spaces from the screen line
+}
+
+static void put_text(std::vector<uint8_t> &out, const char *s)
+{
+	for (; *s; s++) out.push_back(*s == '\n' ? 0x0D : to_pet(*s));
+}
+
+static void put_field(std::vector<uint8_t> &out, const char *s, int width)
+{
+	int l = (int)strlen(s);
+	for (int i = 0; i < width; i++) out.push_back(i < l ? to_pet(s[i]) : ' ');
+}
+
+static std::string base_of(const std::string &n)
+{
+	size_t dot = n.rfind('.');
+	if (dot == std::string::npos || dot == 0 || n.size() - dot > 4) return n;
+	return n.substr(0, dot);
+}
+
+static std::string ext_of(const std::string &n)
+{
+	size_t dot = n.rfind('.');
+	if (dot == std::string::npos || dot == 0 || n.size() - dot > 4) return "";
+	return n.substr(dot + 1);
+}
+
+// --------------------------------------------------------------- the folder, as the menu sees it
+
+// the menu's own scan of the current folder: same filter (the core's file types), same sort,
+// ".." at the top below /media/fat, zips as folders
+static void scan(std::vector<Entry> &v, int all = 0)
+{
+	v.clear();
+	if (!strcmp(cwd, DRIVES))
+	{
+		Entry sd = { "SD CARD", 1, 0, sd_root(), 0, "" };
+		v.push_back(sd);
+		if (net_conf) v.push_back({ "NETWORK", 1, 0, net_root, net_state != 2, net_state == 2 ? "" : "  OFF" });
+		for (int n = 0; n < 4; n++)
+		{
+			char u[64], nm[16];
+			snprintf(u, sizeof(u), "../usb%d/games/C64", n);
+			snprintf(nm, sizeof(nm), "USB %d", n + 1);
+			if (dir_at(u)) v.push_back({ nm, 1, 0, u, 0, "" });
+		}
+		return;
+	}
+	static char path[1024];
+	snprintf(path, sizeof(path), "%s", cwd);
+	ScanDirectory(path, SCANF_INIT, OS_EXTS, SCANO_DIR);
+	int n = flist_nDirEntries();
+	for (int i = 0; i < n; i++)
+	{
+		direntext_t *e = flist_DirItem(i);
+		if (!e) continue;
+		Entry x;
+		x.na = 0;
+		x.name = e->de.d_name;
+		x.dir = e->de.d_type == DT_DIR;
+		x.up = !strcmp(e->de.d_name, "..");
+		v.push_back(x);
+	}
+	if (!cwd[0]) v.insert(v.begin(), { "..", 1, 1, "", 0, "" });   // the very top: up to the drives
+	// a demo's folder: its .prg first (the bar starts on it)
+	(void)all;
+	auto is_ext = [](const std::string &n, const char *x) { return ends_with(n.c_str(), x); };
+	std::vector<Entry> w;
+	for (auto &e : v) if (e.up || e.dir) w.push_back(e);
+	for (auto &e : v) if (!e.up && !e.dir && is_ext(e.name, ".prg")) w.push_back(e);
+	for (auto &e : v)
+	{
+		if (e.up || e.dir || is_ext(e.name, ".prg")) continue;
+		w.push_back(e);
+	}
+	v.swap(w);
+}
+
+static std::string full_of(const std::string &name)
+{
+	return std::string(OS_TOP "/") + (cwd[0] ? std::string(cwd) + "/" : std::string()) + name;
+}
+
+static long long size_of(const Entry &e)
+{
+	if (e.dir) return -1;
+	struct stat st;
+	if (stat(full_of(e.name).c_str(), &st)) return -1;     // inside a zip: no size to show
+	return st.st_size;
+}
+
+static long long blocks_of(const Entry &e)
+{
+	long long z = size_of(e);
+	if (z < 0) return 0;
+	long long b = (z + 253) / 254;
+	return b > 9999 ? 9999 : b;
+}
+
+// the size as the browser shows it, 5 characters: disk blocks up to 999 (as a C64 lists them),
+// then K and M - a 16 MB .reu is "16M", not 65535 blocks
+static void size_text(const Entry &e, char *out)
+{
+	long long z = size_of(e);
+	char t[16] = "";
+	if (z >= 0)
+	{
+		long long b = (z + 253) / 254;
+		if (b < 1000) snprintf(t, sizeof(t), "%lld", b);
+		else if (z < 1000LL * 1024) snprintf(t, sizeof(t), "%lldK", (z + 1023) / 1024);
+		else if (z < 1000LL * 1024 * 1024) snprintf(t, sizeof(t), "%lldM", (z + 1024 * 1024 - 1) / (1024 * 1024));
+		else snprintf(t, sizeof(t), "%lldG", (z + (1LL << 30) - 1) >> 30);
+	}
+	snprintf(out, 6, "%5s", t);
+}
+
+// a name the C64 can show: PETSCII letters, digits and punctuation; anything else becomes '?',
+// and a name that would come out blank is shown with its folder mark or as "?"
+static std::string shown_name(const Entry &e)
+{
+	if (e.up) return ".. (UP A FOLDER)";
+	std::string n = e.dir ? e.name : base_of(e.name);
+	if (n.find_first_not_of(" ") == std::string::npos) n = "?";
+	return n;
+}
+
+static int type_of(const Entry &e)
+{
+	if (e.na) return 6;
+	if (e.up) return 5;
+	if (e.dir) return 0;
+	const char *n = e.name.c_str();
+	if (ends_with(n, ".prg")) return 1;
+	if (ends_with(n, ".d64") || ends_with(n, ".g64") || ends_with(n, ".t64") || ends_with(n, ".d81")) return 2;
+	if (ends_with(n, ".crt")) return 3;
+	return 4;
+}
+
+// find NAME among the entries (dirs or files): whole name, without its extension, then by its start
+static int find_entry(const std::vector<Entry> &v, const char *want, int dirs)
+{
+	char w[64];
+	snprintf(w, sizeof(w), "%s", want);
+	size_t wl = strlen(w);
+	if (wl && w[wl - 1] == '*') w[--wl] = 0;
+	if (!wl) return -1;
+	for (int pass = 0; pass < 3; pass++)
+	{
+		for (size_t i = 0; i < v.size(); i++)
+		{
+			if (v[i].dir != dirs || v[i].up) continue;
+			const std::string &n = v[i].name;
+			if (pass == 0 && !strcasecmp(n.c_str(), w)) return (int)i;
+			if (pass == 1 && !strcasecmp(base_of(n).c_str(), w)) return (int)i;
+			if (pass == 2 && !strncasecmp(n.c_str(), w, wl)) return (int)i;
+		}
+	}
+	return -1;
+}
+
+static void keep_cwd()
+{
+	FILE *f = fopen(OS_CWD, "w");
+	if (f) { fprintf(f, "%s\n", cwd); fclose(f); }
+	if (strcmp(cwd, DRIVES) && (f = fopen(OS_LAST, "w"))) { fprintf(f, "%s\n", cwd); fclose(f); }
+}
+
+// the drive a folder is on: its root (the folder F3 goes up to the drives from)
+static int is_drive_root(const char *c)
+{
+	if (!strcmp(c, DRIVES)) return 0;
+	if (!strcmp(c, sd_root().c_str()) || !c[0]) return 1;
+	if (net_root[0] && !strcmp(c, net_root)) return 1;
+	for (int n = 0; n < 4; n++) { char u[64]; snprintf(u, sizeof(u), "../usb%d/games/C64", n); if (!strcmp(c, u)) return 1; }
+	return 0;
+}
+
+static void go_up()
+{
+	if (!strcmp(cwd, DRIVES)) return;
+	if (is_drive_root(cwd)) { snprintf(cwd, sizeof(cwd), DRIVES); return; }
+	char *s = strrchr(cwd, '/');
+	if (s) *s = 0;
+	else cwd[0] = 0;
+	if (!strcmp(cwd, "..")) snprintf(cwd, sizeof(cwd), DRIVES);
+}
+
+static void go_into(const std::string &name);
+static void go_entry(const Entry &e)
+{
+	if (!strcmp(cwd, DRIVES)) snprintf(cwd, sizeof(cwd), "%s", e.target.c_str());
+	else go_into(e.name);
+	if (!strcmp(cwd, DRIVES) == 0 && is_drive_root(cwd)) snprintf(os_start, sizeof(os_start), "%s", cwd);
+}
+
+static void go_into(const std::string &name)
+{
+	if (!strcmp(cwd, DRIVES)) return;
+	size_t l = strlen(cwd);
+	snprintf(cwd + l, sizeof(cwd) - l, "%s%s", l ? "/" : "", name.c_str());
+}
+
+// a file, exactly as picking it in the menu does it (the core's F1 PRGCRTREU and S0 entries)
+static int run_path(const std::string &path, const std::vector<Entry> *folder)
+{
+	const char *p = path.c_str();
+	if (ends_with(p, ".d64") || ends_with(p, ".g64") || ends_with(p, ".t64") || ends_with(p, ".d81"))
+	{
+		mb_reply(ST_DONE, 0, -1, 8);                // VALUE 8: a disk went into drive 8
+		os_log("  mount #8 %s", p);
+		user_io_file_mount(p, 0);
+		return 1;
+	}
+	int idx = ends_with(p, ".prg") ? 0x01 : ends_with(p, ".crt") ? 0x41 : ends_with(p, ".reu") ? 0x81 : -1;
+	if (idx < 0) { mb_reply(E_CANTRUN, 0); return 0; }
+
+	std::string reu;
+	if (idx == 0x01 && folder)
+	{
+		// a demo's REU goes in first, as its launcher does: the .reu of the same name, or the only
+		// .reu in the folder
+		std::string base = base_of(path.substr(path.rfind('/') + 1));
+		int reus = 0;
+		std::string only;
+		for (auto &e : *folder)
+		{
+			if (e.dir || strcasecmp(ext_of(e.name).c_str(), "reu")) continue;
+			reus++;
+			only = e.name;
+			if (!strcasecmp(base_of(e.name).c_str(), base.c_str())) reu = e.name;
+		}
+		if (reu.empty() && reus == 1) reu = only;
+	}
+	if (idx == 0x81)
+	{
+		// a .reu on its own: attached as the menu does it (no reset, the C64 carries on), and the
+		// answer comes once it is in - VALUE 2, RESULT its size in 64 KB
+		os_log("  REU %s (index 0x81)", p);
+		c64_open_file(p, 0x81);
+		reu_in = path;
+		struct stat st;
+		long kb64 = stat(p, &st) ? 0 : (long)((st.st_size + 65535) >> 16);
+		// LEN: where the .prg it goes with is in the list, for the bar ($FFFF none)
+		int at = 0xFFFF;
+		if (folder)
+		{
+			std::vector<Entry> vis;
+			scan(vis);
+			std::string b = base_of(path.substr(path.rfind('/') + 1));
+			for (int i = 0; i < (int)vis.size(); i++)
+				if (!vis[i].dir && ends_with(vis[i].name.c_str(), ".prg") && !strcasecmp(base_of(vis[i].name).c_str(), b.c_str())) { at = i; break; }
+		}
+		mb_reply(ST_DONE, (int)kb64, at, 2);
+		return 1;
+	}
+	mb_reply(ST_DONE, 0, -1, 1);                    // the core resets now: the reply goes first
+	if (!reu.empty() && full_of(reu) == reu_in) os_log("  REU %s is in already", full_of(reu).c_str());
+	else if (!reu.empty())
+	{
+		os_log("  REU %s (index 0x81)", full_of(reu).c_str());
+		c64_open_file(full_of(reu).c_str(), 0x81);
+		reu_in = full_of(reu);
+	}
+	os_log("  load %s (index 0x%02X)", p, idx);
+	user_io_store_filename(p);
+	c64_open_file(p, idx);
+	return 1;
+}
+
+// ----------------------------------------------------------------------------------- commands
+
+static void cmd_dir(uint16_t addr, int first, int lines)
+{
+	std::vector<Entry> v;
+	scan(v);
+	if (lines <= 0 || lines > 40) lines = 20;
+	if (!addr) addr = 0xA000;
+	int total = (int)v.size();
+	int files = 0;
+	for (auto &e : v) files += !e.up;
+
+	std::vector<uint8_t> out;
+	char line[96];
+	if (first == 0)
+	{
+		const char *leaf = strrchr(cwd, '/');
+		leaf = leaf ? leaf + 1 : (cwd[0] ? cwd : "/");
+		char nm[20];
+		snprintf(nm, sizeof(nm), "%-16.16s", leaf);
+		out.push_back(0x12);                        // reverse on, like a disk header
+		snprintf(line, sizeof(line), "0 \"%s\" OS 1", nm);
+		put_text(out, line);
+		out.push_back(0x92);
+		out.push_back(0x0D);
+	}
+	int i = first, shown = 0;
+	for (; i < total && shown < lines; i++, shown++)
+	{
+		const Entry &e = v[i];
+		std::string sn = e.up ? ".." : shown_name(e);
+		std::string type = (e.dir || e.up) ? "DIR" : ext_of(e.name);
+		if (sn.size() > 26) sn = sn.substr(0, 26);
+		char q[40];
+		snprintf(q, sizeof(q), "\"%s\"", sn.c_str());
+		snprintf(line, sizeof(line), "%-5lld%-18s %.3s\n", blocks_of(e), q, type.c_str());
+		put_text(out, line);
+	}
+	int more = i < total;
+	if (!more)
+	{
+		snprintf(line, sizeof(line), "%d %s.\n", files, files == 1 ? "ENTRY" : "ENTRIES");
+		put_text(out, line);
+	}
+	out.push_back(0);
+	ram_write(addr, out.data(), out.size());
+	mb_reply(ST_DONE, (int)out.size(), i, more);
+}
+
+// NAME: a folder here, ".." for up; a leading "/" starts from the start folder ("/" alone goes
+// back there); "A/B" goes down more than one. On a miss the folder stays as it was.
+static void cmd_chdir(const char *name)
+{
+	char keep[sizeof(cwd)];
+	snprintf(keep, sizeof(keep), "%s", cwd);
+	if (name[0] == '/' || !name[0])
+	{
+		snprintf(cwd, sizeof(cwd), "%s", os_start);
+		while (*name == '/') name++;
+	}
+	char part[64];
+	while (*name)
+	{
+		int n = 0;
+		while (*name && *name != '/' && n < 63) part[n++] = *name++;
+		part[n] = 0;
+		while (*name == '/') name++;
+		if (!n) continue;
+		if (!strcmp(part, "..")) { go_up(); continue; }
+		std::vector<Entry> v;
+		scan(v);
+		int k = find_entry(v, part, 1);
+		if (k < 0)
+		{
+			int err = find_entry(v, part, 0) >= 0 ? E_NOTDIR : E_NOTFOUND;
+			snprintf(cwd, sizeof(cwd), "%s", keep);
+			mb_reply(err, 0);
+			return;
+		}
+		if (v[k].na) { snprintf(cwd, sizeof(cwd), "%s", keep); mb_reply(E_NOTCONN, 0); return; }
+		go_entry(v[k]);
+	}
+	mb_reply(ST_DONE, 0);
+}
+
+static void cmd_load(const char *name, uint16_t addr, int use_addr)
+{
+	std::vector<Entry> v;
+	scan(v);
+	int k = find_entry(v, name, 0);
+	if (k < 0) { mb_reply(E_NOTFOUND, 0); return; }
+	fileTYPE f = {};
+	if (!FileOpen(&f, full_of(v[k].name).c_str())) { mb_reply(E_READ, 0); return; }
+	static uint8_t buf[65536 + 2];
+	int n = FileReadAdv(&f, buf, sizeof(buf));
+	FileClose(&f);
+	if (n < 2) { mb_reply(E_READ, 0); return; }
+	uint16_t at = use_addr ? addr : (uint16_t)(buf[0] | (buf[1] << 8));
+	size_t len = n - 2;
+	if ((size_t)at + len > 0x10000) { mb_reply(E_TOOBIG, 0); return; }
+	ram_write(at, buf + 2, (uint32_t)len);
+	mb_reply(ST_DONE, (at + len) & 0xFFFF);
+}
+
+static void cmd_run(const char *name)
+{
+	std::vector<Entry> v;
+	scan(v, 1);
+	int k = find_entry(v, name, 0);
+	if (k < 0) { mb_reply(E_NOTFOUND, 0); return; }
+	std::vector<Entry> all;
+	scan(all, 1);
+	run_path(full_of(v[k].name), &all);
+}
+
+static void cmd_info(uint16_t addr)
+{
+	if (!addr) addr = 0xA000;
+	std::vector<uint8_t> out;
+	char line[200];
+	extern const char *version;
+	snprintf(line, sizeof(line), "OCTOPHONIC OS 1, MAIN %s\nFOLDER /%s\n", version + 5, cwd);
+	put_text(out, line);
+	out.push_back(0);
+	ram_write(addr, out.data(), out.size());
+	mb_reply(ST_DONE, (int)out.size());
+}
+
+// record (32 bytes): type (0 folder, 1 program, 2 disk, 3 cartridge, 4 other, 5 ".."), the size as
+// text (5, right-aligned: blocks, or K/M), the extension (3), the name (23), PETSCII, space-filled
+static void cmd_list(uint16_t addr, int first, int count)
+{
+	std::vector<Entry> v;
+	scan(v);
+	if (!addr) addr = 0xCA00;
+	if (count <= 0 || count > 32) count = 17;
+	int total = (int)v.size();
+	std::vector<uint8_t> out;
+	char path[1100];
+	if (!strcmp(cwd, DRIVES)) snprintf(path, sizeof(path), "DRIVES");
+	else if (!strncmp(cwd, "../", 3)) snprintf(path, sizeof(path), "/MEDIA/%s", cwd + 3);
+	else snprintf(path, sizeof(path), "/%s", cwd);
+	size_t pl = strlen(path);
+	put_field(out, pl > 40 ? (std::string("...") + (path + pl - 37)).c_str() : path, 40);
+	int written = 0;
+	for (int i = first; i < total && written < count; i++, written++)
+	{
+		const Entry &e = v[i];
+		uint8_t rec[32];
+		memset(rec, ' ', sizeof(rec));
+		char sz[8];
+		if (!e.size.empty()) snprintf(sz, sizeof(sz), "%5s", e.size.c_str());
+		else size_text(e, sz);
+		rec[0] = (uint8_t)type_of(e);
+		for (int k = 0; k < 5; k++) rec[1 + k] = to_pet(sz[k]);
+		std::string ext = !strcmp(cwd, DRIVES) ? "DRV" : (e.dir || e.up) ? "DIR" : ext_of(e.name);
+		for (int k = 0; k < 3 && k < (int)ext.size(); k++) rec[6 + k] = to_pet(ext[k]);
+		std::string nm = shown_name(e);
+		for (int k = 0; k < 23 && k < (int)nm.size(); k++) rec[9 + k] = to_pet(nm[k]);
+		out.insert(out.end(), rec, rec + 32);
+	}
+	ram_write(addr, out.data(), out.size());
+	mb_reply(ST_DONE, total, -1, written);
+}
+
+static void cmd_open(int idx)
+{
+	std::vector<Entry> v;
+	scan(v);
+	if (idx < 0 || idx >= (int)v.size()) { mb_reply(E_NOTFOUND, 0); return; }
+	const Entry &e = v[idx];
+	if (e.up) { go_up(); mb_reply(ST_DONE, 0, -1, 0x10); return; }
+	if (e.na) { mb_reply(E_NOTCONN, 0); return; }
+	if (e.dir) { go_entry(e); mb_reply(ST_DONE, 0, -1, 0x10); return; }
+	os_log("  open %s", e.name.c_str());
+	std::vector<Entry> all;
+	scan(all, 1);
+	run_path(full_of(e.name), &all);
+}
+
+// the browser itself: SHELL.PRG next to os.ini, into RAM at its own load address, no reset
+static void cmd_shell()
+{
+	FILE *f = fopen(OS_SHELL, "rb");
+	if (!f) { os_log("  %s is missing", OS_SHELL); mb_reply(E_NOTFOUND, 0); return; }
+	static uint8_t buf[16384 + 2];
+	size_t n = fread(buf, 1, sizeof(buf), f);
+	fclose(f);
+	if (n < 3) { mb_reply(E_READ, 0); return; }
+	uint16_t at = buf[0] | (buf[1] << 8);
+	ram_write(at, buf + 2, (uint32_t)(n - 2));
+	mb_reply(ST_DONE, at);
+}
+
+// ----------------------------------------------------------------------------------- settings
+
+// the menu options the settings page shows: the same option bits as the core's menu (c64.sv)
+struct Opt { const char *label; const char *bits; const char *choices[5]; int n; };
+static const Opt opts[] = {
+	{ "LEFT SIDS 1357",   "[13]",     { "6581", "8580" }, 2 },
+	{ "RIGHT SIDS 2468",  "[16]",     { "6581", "8580" }, 2 },
+	{ "MY CHIPS",         "[101]",    { "ON", "OFF" }, 2 },
+	{ "OCTOPHONIC",       "[98:97]",  { "8 SIDS", "4 SIDS", "OFF" }, 3 },
+	{ "OCTOSID FX",       "[100:99]", { "OFF", "CHORUS", "ECHO", "CHORUS+ECHO" }, 4 },
+	{ "SPLIT SCREENS",    "[102]",    { "OFF", "VGA C64+HDMI" }, 2 },
+	{ "TURBO MODE",       "[47:46]",  { "C128", "OFF", "SMART" }, 3 },
+	{ "TURBO SPEED",      "[49:48]",  { "2X", "3X", "4X" }, 3 },
+};
+#define N_OPTS ((int)(sizeof(opts) / sizeof(opts[0])))
+// lines: 0 the chip preset, 1 left chip file, 2 right chip file, then the options
+#define S_PRESET 0
+#define S_CHIPL  1
+#define S_CHIPR  2
+#define S_START  3       // where the OS starts: network / SD card / last used (os.ini startin=)
+#define S_OPT0   4
+static const char *startins[3] = { "net", "sd", "last" };
+static const char *startnames[3] = { "NETWORK", "SD CARD", "LAST USED" };
+static int startin_now()
+{
+	for (int i = 0; i < 3; i++) if (!strcasecmp(os_startin, startins[i])) return i;
+	return net_conf ? 0 : 1;
+}
+
+static std::vector<std::string> presets;   // the Octophonic launchers in _Computer
+static int preset_sel = -1;                // the one chosen on the page (applied by SETAPPLY)
+
+static void scan_presets()
+{
+	presets.clear();
+	DIR *d = opendir(OS_TOP "/_Computer");
+	if (!d) return;
+	while (struct dirent *de = readdir(d))
+		if (!strncasecmp(de->d_name, "Octophonic 64", 13) && ends_with(de->d_name, ".mgl"))
+			presets.push_back(std::string("_Computer/") + de->d_name);
+	closedir(d);
+	std::sort(presets.begin(), presets.end(), [](const std::string &a, const std::string &b) { return strcasecmp(a.c_str(), b.c_str()) < 0; });
+}
+
+static int current_preset()
+{
+	for (int i = 0; i < (int)presets.size(); i++) if (!strcasecmp(presets[i].c_str(), os_boot)) return i;
+	return -1;
+}
+
+static std::string preset_label(int i)
+{
+	if (i < 0 || i >= (int)presets.size()) return "?";
+	std::string s = presets[i].substr(10);         // without _Computer/
+	s = base_of(s);
+	if (!strncasecmp(s.c_str(), "Octophonic 64 - ", 16)) s = s.substr(16);
+	else if (!strcasecmp(s.c_str(), "Octophonic 64")) s = "PLAIN";
+	size_t p = s.find(" (");
+	if (p != std::string::npos) s = s.substr(0, p);
+	return s;
+}
+
+static void scan_chips(std::vector<std::string> &v)
+{
+	v.clear();
+	DIR *d = opendir(OS_TOP "/" CHIP_DIR);
+	if (!d) return;
+	while (struct dirent *de = readdir(d))
+		if (de->d_name[0] != '.' && ends_with(de->d_name, ".chp")) v.push_back(de->d_name);
+	closedir(d);
+	std::sort(v.begin(), v.end(), [](const std::string &a, const std::string &b) { return strcasecmp(a.c_str(), b.c_str()) < 0; });
+}
+
+// the chip file the menu remembers for "Load My Chip" n (2 left, 3 right): the FC entries' store
+static std::string chip_stored(int n)
+{
+	char cfgname[64], path[1024] = {};
+	snprintf(cfgname, sizeof(cfgname), "%s.f%d", user_io_get_core_name(), n);
+	if (FileLoadConfig(cfgname, path, sizeof(path) - 1) <= 0) return "";
+	const char *s = strrchr(path, '/');
+	return s ? s + 1 : path;
+}
+
+static void chip_load(int n, const std::string &file)
+{
+	char path[1024];
+	snprintf(path, sizeof(path), OS_TOP "/" CHIP_DIR "/%s", file.c_str());
+	os_log("  chip %s: %s (index %d)", n == 2 ? "left" : "right", path, n);
+	char cfgname[64];
+	snprintf(cfgname, sizeof(cfgname), "%s.f%d", user_io_get_core_name(), n);
+	FileSaveConfig(cfgname, path, sizeof(path));      // as the menu's FC entry remembers it
+	c64_open_file(path, n);                          // and loads it (CHP is the entry's first type)
+}
+
+static void cmd_setlist(uint16_t addr)
+{
+	if (!addr) addr = 0xCA00;
+	scan_presets();
+	if (preset_sel < 0 || preset_sel >= (int)presets.size()) preset_sel = current_preset();
+	std::vector<uint8_t> out;
+	char val[64];
+	int cur = current_preset();
+	snprintf(val, sizeof(val), "%s%s", preset_label(preset_sel).c_str(), (preset_sel != cur) ? " (RETURN)" : "");
+	put_field(out, "CHIP PRESET", 20); put_field(out, val, 20);
+	for (int n = 2; n <= 3; n++)
+	{
+		std::string c = chip_stored(n);
+		put_field(out, n == 2 ? "MY CHIP LEFT" : "MY CHIP RIGHT", 20);
+		put_field(out, c.empty() ? "-" : base_of(c).c_str(), 20);
+	}
+	put_field(out, "START IN", 20);
+	put_field(out, startnames[startin_now()], 20);
+	for (int i = 0; i < N_OPTS; i++)
+	{
+		uint32_t x = user_io_status_get(opts[i].bits);
+		put_field(out, opts[i].label, 20);
+		put_field(out, (int)x < opts[i].n ? opts[i].choices[x] : "?", 20);
+	}
+	ram_write(addr, out.data(), out.size());
+	mb_reply(ST_DONE, S_OPT0 + N_OPTS);
+}
+
+static void cmd_setstep(int line, int dir)
+{
+	int step = (dir == 0xFF) ? -1 : 1;
+	if (line == S_PRESET)
+	{
+		scan_presets();
+		if (presets.empty()) { mb_reply(E_NOTFOUND, 0); return; }
+		if (preset_sel < 0) preset_sel = current_preset();
+		preset_sel = (preset_sel + step + (int)presets.size()) % (int)presets.size();
+		mb_reply(ST_DONE, 0);
+		return;
+	}
+	if (line == S_CHIPL || line == S_CHIPR)
+	{
+		int n = line == S_CHIPL ? 2 : 3;
+		std::vector<std::string> v;
+		scan_chips(v);
+		if (v.empty()) { mb_reply(E_NOTFOUND, 0); return; }
+		std::string c = chip_stored(n);
+		int k = -1;
+		for (int i = 0; i < (int)v.size(); i++) if (!strcasecmp(v[i].c_str(), c.c_str())) k = i;
+		k = (k + step + (int)v.size()) % (int)v.size();
+		mb_reply(ST_DONE, 0);
+		chip_load(n, v[k]);
+		return;
+	}
+	if (line == S_START)
+	{
+		int k = (startin_now() + step + 3) % 3;
+		snprintf(os_startin, sizeof(os_startin), "%s", startins[k]);
+		write_key("startin", startins[k]);
+		os_log("  start in %s", startins[k]);
+		mb_reply(ST_DONE, 0);
+		return;
+	}
+	int i = line - S_OPT0;
+	if (i < 0 || i >= N_OPTS) { mb_reply(E_BADCMD, 0); return; }
+	uint32_t x = user_io_status_get(opts[i].bits);
+	x = (x + step + opts[i].n) % opts[i].n;
+	user_io_status_set(opts[i].bits, x);              // as the menu does on a change
+	user_io_status_save(user_io_create_config_name(1)); // and its Save Settings
+	os_log("  option %s %s = %s", opts[i].label, opts[i].bits, opts[i].choices[x]);
+	mb_reply(ST_DONE, 0);
+}
+
+static void cmd_setapply()
+{
+	scan_presets();
+	if (preset_sel < 0 || preset_sel >= (int)presets.size()) { mb_reply(E_NOTFOUND, 0); return; }
+	std::string p = presets[preset_sel];
+	write_boot(p.c_str());
+	mb_reply(ST_DONE, 0, -1, 1);                     // the core restarts with the preset
+	char full[1024];
+	snprintf(full, sizeof(full), OS_TOP "/%s", p.c_str());
+	os_log("  preset %s (and the boot preset from now on)", full);
+	xml_load(full);                                  // as picking the launcher in the menu
+}
+
+// ------------------------------------------------------- CTRL+F12: out of a demo, to the start
+
+// a demo doesn't listen to the mailbox and often blocks RUN/STOP+RESTORE, so Main does it: the
+// menu's "Reset & Detach Cartridge" (R[17]) - the core starts again on the V1.1 start screen.
+// The folder is kept, so F1 opens the browser where it was; the REU keeps its contents, as it
+// does for the menu's reset.
+void octo_exit()
+{
+	if (!os_active) return;
+	os_log("CTRL+F12: reset to the start screen (folder /%s)", cwd);
+	user_io_status_set("[17]", 1);
+	user_io_status_set("[17]", 0);
+}
+
+// ------------------------------------------------------------------------- F12 held: the menu
+
+void octo_f12(int press)
+{
+	if (!os_active || user_io_osd_is_visible()) { f12_time = 0; return; }
+	if (press == 1) f12_time = GetTimer(2000);       // the first press only: repeats don't count
+	else if (!press) f12_time = 0;
+}
+
+// --------------------------------------------------------------------------------------- poll
+
+// --------------------------------------------------------------------- screenshots and reports
+//
+// SHOT: MiSTer's own screenshot (scaler.cpp: the picture is copied out of video memory at the next
+// vsync, then written as a PNG by a worker thread) under a temporary name in /media/fat/screenshots,
+// then copied to the share once it is written - the C64 never waits for any of it.
+
+#define SHOT_TMP   "/media/fat/screenshots"
+struct ShotJob { std::string tmp, dest; unsigned long deadline; };
+static std::vector<ShotJob> shots;
+static unsigned long shot_timer = 0;
+static int shot_n = 0;
+static std::string append_file[4];
+
+// where screenshots and reports go: the share's Octophonic/Screenshots, or the SD card's
+static std::string report_dir()
+{
+	if (net_state == 2 && net_root[0]) return std::string(OS_TOP "/") + net_root + "/Octophonic/Screenshots";
+	return std::string(OS_TOP "/screenshots/Octophonic");
+}
+
+static void make_dirs(const std::string &path)        // mkdir -p of the folder part
+{
+	std::string p;
+	for (size_t i = 1; i < path.size(); i++)
+		if (path[i] == '/') { p = path.substr(0, i); mkdir(p.c_str(), 0777); }
+}
+
+// a name the 6502 sent, safe as a path below the report folder: letters, digits, - _ . and / only
+static std::string safe_rel(const char *name)
+{
+	std::string r;
+	for (const char *p = name; *p; p++)
+	{
+		char c = *p;
+		if (isalnum((unsigned char)c) || c == '-' || c == '_' || c == '/') r += c;
+		else if (c == '.' && !(r.size() && r.back() == '.')) r += c;
+		else if (c == ' ') r += '_';
+	}
+	while (!r.empty() && (r[0] == '/' || r[0] == '.')) r.erase(0, 1);
+	if (r.empty()) r = "shot";
+	return r;
+}
+
+static int copy_file(const char *from, const char *to)
+{
+	int in = open(from, O_RDONLY);
+	if (in < 0) return 0;
+	int out = open(to, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+	if (out < 0) { close(in); return 0; }
+	static char buf[65536];
+	int ok = 1;
+	ssize_t n;
+	while ((n = read(in, buf, sizeof(buf))) > 0) if (write(out, buf, n) != n) { ok = 0; break; }
+	if (n < 0) ok = 0;
+	close(in);
+	if (close(out)) ok = 0;
+	return ok;
+}
+
+static int take_shot(const std::string &rel)
+{
+	if (shot_timer && !CheckTimer(shot_timer)) return 0;      // at most one a second
+	if (screenshot_state()) return 0;                         // one at a time (MiSTer's rule)
+	shot_timer = GetTimer(1000);
+	const char *ext = !strcasecmp(cfg.screenshot_image_format, "bmp") ? ".bmp" : ".png";
+	char tmp[64];
+	snprintf(tmp, sizeof(tmp), "octoshot_%d%s", shot_n++ % 100, ext);
+	std::string dest = report_dir() + "/" + rel;
+	if (dest.size() < 4 || strcasecmp(dest.c_str() + dest.size() - 4, ext)) dest += ext;
+	screenshot_quiet = 1;
+	request_screenshot(tmp, 0);                               // native size, as the core draws it
+	shots.push_back({ std::string(SHOT_TMP "/") + tmp, dest, GetTimer(15000) });
+	return 1;
+}
+
+// the screenshots once MiSTer has written them: onto the share
+static void shots_poll()
+{
+	if (shots.empty() || screenshot_state()) return;
+	ShotJob &j = shots.front();
+	struct stat st;
+	if (!stat(j.tmp.c_str(), &st) && st.st_size > 0)
+	{
+		make_dirs(j.dest);
+		if (copy_file(j.tmp.c_str(), j.dest.c_str())) { unlink(j.tmp.c_str()); os_log("shot: %s", j.dest.c_str()); }
+		else os_log("shot: could not copy %s to %s", j.tmp.c_str(), j.dest.c_str());
+		shots.erase(shots.begin());
+	}
+	else if (CheckTimer(j.deadline))
+	{
+		os_log("shot: MiSTer wrote no %s (scaler off?)", j.tmp.c_str());
+		shots.erase(shots.begin());
+	}
+	if (shots.empty()) screenshot_quiet = 0;
+}
+
+void octo_manual_shot()
+{
+	char rel[64];
+	time_t t = time(0);
+	struct tm *tm = localtime(&t);
+	if (tm->tm_year >= 119) strftime(rel, sizeof(rel), "Manual/%Y%m%d_%H%M%S", tm);
+	else snprintf(rel, sizeof(rel), "Manual/shot_%04d", shot_n);
+	os_log("CTRL+F11: %s", take_shot(rel) ? rel : "busy - no screenshot");
+}
+
+static void cmd_shot(const char *name)
+{
+	take_shot(safe_rel(name));
+	mb_reply(ST_DONE, 0);                                     // never waits for the picture
+}
+
+static void cmd_append(int slot, int value, const char *text)
+{
+	slot &= 3;
+	if (value == 0xFF)
+	{
+		append_file[slot] = safe_rel(text);
+		mb_reply(ST_DONE, 0);
+		return;
+	}
+	if (append_file[slot].empty()) { mb_reply(E_NOTFOUND, 0); return; }
+	std::string path = report_dir() + "/" + append_file[slot];
+	make_dirs(path);
+	FILE *f = fopen(path.c_str(), "a");
+	if (!f) { mb_reply(E_READ, 0); return; }
+	fputs(text, f);
+	if (!(value & 1)) fputs("\r\n", f);
+	fclose(f);
+	mb_reply(ST_DONE, 0);
+}
+
+void octo_poll()
+{
+	if (!os_active) return;
+	if (f12_time && CheckTimer(f12_time))
+	{
+		f12_time = 0;
+		os_log("F12 held: the MiSTer menu");
+		user_io_octo_menu();
+	}
+	if (!net_timer || CheckTimer(net_timer)) { net_timer = GetTimer(1000); net_update(); }
+	shots_poll();
+	if (((net_state & 3) | shot_bits()) != net_sent) net_publish();   // NET b7/b6: a screenshot under way
+	if (poll_timer && !CheckTimer(poll_timer)) return;
+	poll_timer = GetTimer(4);
+
+	uint16_t w = mb_poll();
+	if ((w >> 8) != OCTO_MAGIC || !(w & 1)) return;
+
+	uint8_t reg[16];
+	char raw[33], name[64];
+	mb_read(reg, raw);
+	from_pet(raw, name, sizeof(name));
+	uint16_t addr = reg[R_ADDRL] | (reg[R_ADDRH] << 8);
+	int len = reg[R_LENL] | (reg[R_LENH] << 8);
+	cur_seq = reg[R_SEQ];
+	unsigned long t0 = GetTimer(0);
+	char was[1024];
+	snprintf(was, sizeof(was), "%s", cwd);
+	last_status = -1;
+
+	switch (reg[R_CMD])
+	{
+	case 0x01: cmd_dir(addr, len, reg[R_VALUE]); break;
+	case 0x02: cmd_chdir(name); break;
+	case 0x03: cmd_load(name, addr, reg[R_ARG] & 1); break;
+	case 0x04: cmd_run(name); break;
+	case 0x05: cmd_info(addr); break;
+	case 0x06: cmd_list(addr, len, reg[R_VALUE]); break;
+	case 0x07: cmd_open(len); break;
+	case 0x08: cmd_setlist(addr); break;
+	case 0x09: cmd_setstep(reg[R_ARG], reg[R_VALUE]); break;
+	case 0x0A: cmd_setapply(); break;
+	case 0x0B: net_wait = 0; snprintf(cwd, sizeof(cwd), "%s", sd_root().c_str()); snprintf(os_start, sizeof(os_start), "%s", cwd);
+	           os_log("network: not waiting - the SD card"); net_update(); mb_reply(ST_DONE, 0); break;
+	case 0x0C: cmd_shot(name); break;
+	case 0x0D: cmd_append(reg[R_ARG], reg[R_VALUE], name); break;
+	case 0x0F: cmd_shell(); break;
+	default:   mb_reply(E_BADCMD, 0); break;
+	}
+	if (strcmp(was, cwd)) keep_cwd();
+
+	// was the answer taken? (the 6502 may have given up and asked something else meanwhile)
+	// (not after RUN, OPEN or a preset: the core may already be restarting)
+	int taken = 1;
+	if (reg[R_CMD] != 0x04 && reg[R_CMD] != 0x07 && reg[R_CMD] != 0x0A)
+	{
+		uint8_t now[16];
+		char nn[33];
+		mb_read(now, nn);
+		taken = now[R_RSEQ] == cur_seq && now[R_SEQ] == cur_seq;
+	}
+	if (reg[R_CMD] == 0x0D && last_status == ST_DONE) return;   // APPEND: too many to log
+	os_log("cmd %02X seq %02X name '%s' addr %04X len %d folder /%s -> /%s status %02X, %lu ms%s",
+		reg[R_CMD], cur_seq, name, addr, len, was, cwd, last_status & 0xFF, GetTimer(0) - t0,
+		taken ? "" : " - too late, the C64 had moved on (reply dropped)");
+}
