+// ---------------------------------------------------------------- batch 1 (c) 2026 Mong00se
+
+// Fix 38 / Fix 54: the screens and the scaling into MiSTer.ini. The first change since Main started
+// backs the old MiSTer.ini up to octophonic/backups/MiSTer.ini.<date-time>; each change is one line
+// in update.log. MiSTer reads MiSTer.ini when it starts: the page says to switch off and on.
+// Nothing is restarted here.
+static int ini_backed = 0;
+static void video_write()
+{
+	int v = os_video < 0 ? 0 : os_video;
+	const char *keys[4] = { ob1_video_ini_keys[0], ob1_video_ini_keys[1], ob1_video_ini_keys[2], "vscale_mode" };
+	const char *vals[4] = { ob1_video_ini_vals[v][0], ob1_video_ini_vals[v][1], ob1_video_ini_vals[v][2], ob1_scale_ini_val[os_scale] };
+	char bak[256] = "";
+	if (!ini_backed)
+	{
+		time_t t = time(0);
+		char ts[32];
+		strftime(ts, sizeof(ts), "%Y%m%d-%H%M%S", localtime(&t));
+		mkdir(OS_DIR "/backups", 0777);
+		snprintf(bak, sizeof(bak), OS_DIR "/backups/MiSTer.ini.%s", ts);
+	}
+	int n = ob1_ini_set(OS_TOP "/MiSTer.ini", keys, vals, 4, bak[0] ? bak : NULL);
+	if (n > 0 && bak[0]) ini_backed = 1;
+	rgb_ulog("F8 settings: video %s, scaling %s -> MiSTer.ini %s%s%s (takes effect at the next switch-on; nothing restarted)",
+		os_video < 0 ? "not set" : ob1_video_key[os_video], ob1_scale_key[os_scale],
+		n < 0 ? "COULD NOT BE WRITTEN" : n == 0 ? "already so" : "changed", n > 0 && bak[0] ? ", old copy " : "", n > 0 && bak[0] ? bak : "");
+}
+
+// Fix 76: OCTOCODE on the card (Tools since Fix 45; Apps on an older card)
+static std::string octocode_path()
+{
+	const char *c[2] = { "Tools/OCTOCODE.PRG", "Apps/OCTOCODE.PRG" };
+	for (int i = 0; i < 2; i++)
+	{
+		std::string p = std::string(OS_TOP "/") + sd_root() + "/" + c[i];
+		if (!access(p.c_str(), R_OK)) return p;
+	}
+	return "";
+}
+
+// SRCOPEN ($19, Fix 76's O): the disk into drive 8, then OCTOCODE, which asks for the source (SRCNAME)
+static void cmd_srcopen(int idx)
+{
+	std::vector<Entry> v;
+	scan(v);
+	if (idx < 0 || idx >= (int)v.size() || type_of(v[idx]) != 2) { mb_reply(E_NOTFOUND, 0); return; }
+	std::string disk = full_of(v[idx].name);
+	char srcn[17];
+	if (!ob1_d64_source(disk.c_str(), srcn)) { mb_reply(E_NOTFOUND, 0); return; }
+	std::string oc = octocode_path();
+	if (oc.empty()) { os_log("  SRCOPEN: no Tools/OCTOCODE.PRG on the card"); mb_reply(E_NOTFOUND, 0); return; }
+	src_pending = srcn;
+	mb_reply(ST_DONE, 0, -1, 1);                    // the core resets now: the reply goes first
+	os_log("  mount #8 %s, source %s, then %s", disk.c_str(), srcn, oc.c_str());
+	user_io_file_mount(disk.c_str(), 0);
+	disk8 = disk;
+	prog_dir = disk.substr(0, disk.rfind('/'));
+	octo_oled_logo(0);
+	user_io_store_filename(oc.c_str());
+	c64_open_file(oc.c_str(), 0x01);
+}
+
+// SRCNAME ($1A): the source SRCOPEN picked (once)
+static void cmd_srcname(uint16_t addr)
+{
+	std::vector<uint8_t> out(src_pending.begin(), src_pending.end());
+	out.push_back(0);
+	ram_write(addr ? addr : 0xA000, out.data(), out.size());
+	int l = (int)src_pending.size();
+	if (l) os_log("  SRCNAME: %s", src_pending.c_str());
+	src_pending.clear();
+	mb_reply(ST_DONE, l);
+}
+
+// NEWDISK ($1B, Fix 46): a blank NAME.d64 in this folder, into drive 8
+static void cmd_newdisk(const char *name)
+{
+	if (!strcmp(cwd, DRIVES) || !name[0]) { mb_reply(E_NOTFOUND, 0); return; }
+	std::string n;
+	for (const char *c = name; *c && n.size() < 16; c++)
+		if (isalnum((unsigned char)*c) || strchr(" -_.!()+", *c)) n.push_back(*c);
+	while (!n.empty() && n.back() == ' ') n.pop_back();
+	if (n.empty()) { mb_reply(E_NOTFOUND, 0); return; }
+	std::string file = n + ".d64";
+	std::string path = full_of(file);
+	char dn[17];
+	size_t k = 0;
+	for (; k < n.size(); k++) dn[k] = (char)to_pet(n[k]);
+	dn[k] = 0;
+	int r = ob1_d64_new(path.c_str(), dn);
+	if (r == -1) { mb_reply(E_THERE, 0); return; }
+	if (r) { os_log("  NEWDISK: can't write %s", path.c_str()); mb_reply(E_READ, 0); return; }
+	user_io_file_mount(path.c_str(), 0);
+	disk8 = path;
+	std::vector<Entry> v;
+	scan(v);
+	int at = 0xFFFF;
+	for (int i = 0; i < (int)v.size(); i++) if (!v[i].dir && !strcasecmp(v[i].name.c_str(), file.c_str())) at = i;
+	rgb_ulog("NEW DISK: %s made and put in drive 8", path.c_str());
+	mb_reply(ST_DONE, 0, at, 8);
+}
